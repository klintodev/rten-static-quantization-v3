+        let mut a_rng = ReducedRangeRng::new(true /* reduce_range */, 1234);
+        let mut b_rng = XorShiftRng::new(5678);
+        let op = QLinearMatMul {};
+
+        let a = Tensor::<u8>::rand(&[5, 10], &mut a_rng);
+
+        // The unpacked and pre-packed versions of an input should use the
+        // same data. Here we intentionally use different tensors with
+        // the same shape so we can verify if the packed data was used.
+        let b = Tensor::<i8>::rand(&[10, 3], &mut b_rng);
+        let packed_b_input = Tensor::<i8>::rand(&[10, 3], &mut b_rng);
+        let packed_b = op.prepack(3, packed_b_input.view().into()).unwrap();
+
+        let a_scale_val = 0.1f32;
+        let b_scale_val = 0.02f32;
+        let y_scale_val = 0.15f32;
+
+        let a_scale = Tensor::from(a_scale_val);
+        let a_zp = Tensor::from(2u8);
+        let b_scale = Tensor::from(b_scale_val);
+        let b_zp = Tensor::from(0i8);
+        let y_scale = Tensor::from(y_scale_val);
+        let y_zp = Tensor::from(7u8);
+
+        let pool = BufferPool::new();
+        let get_prepacked = |idx| {
+            if idx == 3 { Some(&packed_b) } else { None }
+        };
+        let inputs = InputList::from(&[
+            a.view().into(),
+            a_scale.view().into(),
+            a_zp.view().into(),
+            b.view().into(),
+            b_scale.view().into(),
+            b_zp.view().into(),
+            y_scale.view().into(),
+            y_zp.view().into(),
+        ])
+        .with_prepacked(&get_prepacked);
+        let ctx = OpRunContext::new(&pool, &inputs, OutputMask::all_used(1));
+        let mut result = op.run(&ctx).unwrap();
+        let result: Tensor<u8> = result.remove(0).try_into().unwrap();
+
+        let acc = reference_matmul_integer(
+            a.view(),
+            packed_b_input.view(),
+            Some(a_zp.view()),
+            Some(b_zp.view()),
+        );
+        let combined = ChannelScales::Scalar(a_scale_val * b_scale_val / y_scale_val);
+        let expected: Tensor<u8> = requantize_int32(&pool, acc, &combined, 1, 7u8)?;
+        expect_equal(&result, &expected)?;
+
+        Ok(())
+    }
