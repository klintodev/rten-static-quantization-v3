+/// Granularity of a constant quantization parameter in a QDQ pattern.
+#[derive(Clone, Copy, PartialEq)]
+enum QuantParamKind {
+    /// Scalar or single-element vector.
+    PerTensor,
+    /// 1-D vector with more than one element.
+    PerChannel,
+    /// Any other shape, or a non-constant / unknown shape.
+    Unsupported,
+}
+
+/// Classify a constant quantization parameter by its shape.
+fn quant_param_kind(graph: &Graph, node_id: NodeId) -> QuantParamKind {
+    let Some(shape) = graph.get_node(node_id).and_then(|node| node.shape()) else {
+        return QuantParamKind::Unsupported;
+    };
+    match shape.as_ref() {
+        [] | [Dimension::Fixed(1)] => QuantParamKind::PerTensor,
+        [Dimension::Fixed(_)] => QuantParamKind::PerChannel,
+        _ => QuantParamKind::Unsupported,
+    }
+}
+
+/// Get the element type of a constant quantization parameter.
+fn quant_param_dtype(graph: &Graph, node_id: NodeId) -> Option<DataType> {
+    match graph.get_node(node_id)?.dtype()? {
+        ValueType::Tensor(dtype) => Some(dtype),
+        _ => None,
+    }
+}
+
+/// Extract the value of a per-tensor scale constant, which can be a scalar or
+/// single-element vector.
+fn get_per_tensor_scale(graph: &Graph, node_id: NodeId) -> Option<f32> {
+    if let Some(scale) = graph.get_scalar::<f32>(node_id) {
+        Some(scale)
+    } else {
+        graph
+            .get_vector::<f32>(node_id)
+            .filter(|vec| vec.len() == 1)
+            .map(|vec| vec[0])
+    }
+}
+
+/// Validate that a scale constant is per-tensor, positive and finite.
+fn check_per_tensor_scale(graph: &Graph, node_id: NodeId) -> Result<(), FusionError> {
+    match get_per_tensor_scale(graph, node_id) {
+        Some(scale) if scale.is_finite() && scale > 0. => Ok(()),
+        _ => Err(FusionError::CheckFailed(
+            "scale must be a positive and finite per-tensor value",
+        )),
+    }
+}
+
+/// Validate that a zero point constant has type u8 or i8, matching
+/// `expected_dtype` if that is known.
+fn check_zero_point_dtype(
+    graph: &Graph,
+    node_id: NodeId,
+    expected_dtype: Option<DataType>,
+) -> Result<(), FusionError> {
+    let Some(dtype) = quant_param_dtype(graph, node_id) else {
+        return Err(FusionError::CheckFailed("unknown zero point type"));
+    };
+    if !matches!(dtype, DataType::UInt8 | DataType::Int8) {
+        return Err(FusionError::CheckFailed("zero point must be u8 or i8"));
+    }
+    if let Some(expected) = expected_dtype
+        && dtype != expected
+    {
+        return Err(FusionError::CheckFailed(
+            "zero point type does not match data type",
+        ));
+    }
+    Ok(())
+}
+
+/// The axis along which per-channel weight quantization applies for an
+/// operator produced by a QDQ fusion.
+enum WeightQuantAxis {
+    /// Conv weights (OCHW layout): the output channel axis is 0.
+    ConvOutChannels,
+    /// MatMul RHS (K x N layout): the output channel axis is the last axis.
+    MatMulColumns,
+}
+
+/// Check that the constant quantization parameters in a matched
+/// `QuantizeLinear(Op(DequantizeLinear, DequantizeLinear))` pattern are
+/// supported by the QLinearConv / QLinearMatMul operators.
+fn check_qlinear_params(
+    graph: &Graph,
+    pat_match: &Match,
+    weight_axis: WeightQuantAxis,
+    weight_dq_axis: isize,
+) -> Result<(), FusionError> {
+    let x_scale = pat_match.node_id("x_scale").unwrap();
+    let x_zero = pat_match.node_id("x_zero").unwrap();
+    let w = pat_match.node_id("w").unwrap();
+    let w_scale = pat_match.node_id("w_scale").unwrap();
+    let w_zero = pat_match.node_id("w_zero").unwrap();
+    let y_scale = pat_match.node_id("y_scale").unwrap();
+    let y_zero = pat_match.node_id("y_zero").unwrap();
+
+    let data_dtype = |name: &str| {
+        let id = pat_match.node_id(name)?;
+        match graph.get_node(id)?.dtype()? {
+            ValueType::Tensor(dtype) => Some(dtype),
+            _ => None,
+        }
+    };
+    let x_dtype = data_dtype("x");
+    let w_dtype = data_dtype("w");
+
+    // Activation scale and zero point must be per-tensor.
+    check_per_tensor_scale(graph, x_scale)?;
+    if quant_param_kind(graph, x_zero) != QuantParamKind::PerTensor {
+        return Err(FusionError::CheckFailed(
+            "activation zero point must be a per-tensor value",
+        ));
+    }
+    check_zero_point_dtype(graph, x_zero, x_dtype)?;
+
+    // Output scale and zero point must be per-tensor.
+    check_per_tensor_scale(graph, y_scale)?;
+    if quant_param_kind(graph, y_zero) != QuantParamKind::PerTensor {
+        return Err(FusionError::CheckFailed(
+            "output zero point must be a per-tensor value",
+        ));
+    }
+    check_zero_point_dtype(graph, y_zero, None)?;
+
+    // Weight scale and zero point must both be per-tensor or both per-channel.
+    match (
+        quant_param_kind(graph, w_scale),
+        quant_param_kind(graph, w_zero),
+    ) {
+        (QuantParamKind::PerTensor, QuantParamKind::PerTensor) => {
+            check_per_tensor_scale(graph, w_scale)?;
+            check_zero_point_dtype(graph, w_zero, w_dtype)?;
+        }
+        (QuantParamKind::PerChannel, QuantParamKind::PerChannel) => {
+            // The quantization axis of the weight DequantizeLinear must match
+            // the operator's output channel axis.
+            let Some(w_rank) = graph.get_rank(w) else {
+                return Err(FusionError::CheckFailed("unknown weight rank"));
+            };
+            let Ok(axis) = resolve_axis(w_rank, weight_dq_axis) else {
+                return Err(FusionError::CheckFailed("invalid weight quantization axis"));
+            };
+            let expected_axis = match weight_axis {
+                WeightQuantAxis::ConvOutChannels => 0,
+                WeightQuantAxis::MatMulColumns if w_rank < 2 => {
+                    return Err(FusionError::CheckFailed(
+                        "per-column weight parameters require a matrix",
+                    ));
+                }
+                WeightQuantAxis::MatMulColumns => w_rank - 1,
+            };
+            if axis != expected_axis {
+                return Err(FusionError::CheckFailed(
+                    "weight quantization axis does not match output channel axis",
+                ));
+            }
+
+            let Some(scales) = graph.get_vector::<f32>(w_scale) else {
+                return Err(FusionError::CheckFailed("weight scale must be f32"));
+            };
+            if !scales.iter().all(|s| s.is_finite() && *s > 0.) {
+                return Err(FusionError::CheckFailed(
+                    "weight scales must be positive and finite",
+                ));
+            }
+            check_zero_point_dtype(graph, w_zero, w_dtype)?;
+        }
+        _ => {
+            return Err(FusionError::CheckFailed(
+                "weight scale and zero point must have the same granularity",
+            ));
+        }
+    }
+
+    Ok(())
+}
+
+/// If the matched QuantizeLinear has an explicit output dtype, check that it
+/// matches the output zero point type, since the fused operator determines
+/// the output type from the zero point.
+fn check_quantize_output_dtype(graph: &Graph, pat_match: &Match) -> Result<(), FusionError> {
+    let q_id = pat_match.node_id("q").unwrap();
+    let y_zero = pat_match.node_id("y_zero").unwrap();
+    if let Some(q) = graph.get_operator::<QuantizeLinear>(q_id)
+        && let Some(dtype) = q.output_dtype
+        && quant_param_dtype(graph, y_zero) != Some(dtype)
+    {
+        return Err(FusionError::CheckFailed(
+            "output dtype does not match zero point type",
+        ));
+    }
+    Ok(())
+}
+
+/// Pattern for `QuantizeLinear(Op(DQ(x, x_scale, x_zp), DQ(w, w_scale, w_zp)), y_scale, y_zp)`.
+///
+/// The scale and zero point inputs must all be constants. Patterns with
+/// missing optional zero point inputs (2-input DequantizeLinear or
+/// QuantizeLinear) or dynamic scale / zero point values do not match.
+fn qdq_compute_pattern(op_name: &'static str, op_key: &'static str, bias: bool) -> Pattern {
+    let x = Pattern::symbol("x");
+    let x_scale = Pattern::const_symbol("x_scale");
+    let x_zero = Pattern::const_symbol("x_zero");
+    let w = Pattern::symbol("w");
+    let w_scale = Pattern::const_symbol("w_scale");
+    let w_zero = Pattern::const_symbol("w_zero");
+    let y_scale = Pattern::const_symbol("y_scale");
+    let y_zero = Pattern::const_symbol("y_zero");
+
+    let mut args = vec![
+        Pattern::operator("DequantizeLinear", [x, x_scale, x_zero]),
+        Pattern::operator("DequantizeLinear", [w, w_scale, w_zero]).with_name("w_dq"),
+    ];
+    if bias {
+        args.push(Pattern::const_symbol("float_bias"));
+    }
+    Pattern::operator(
+        "QuantizeLinear",
+        [
+            Pattern::operator(op_name, args).with_name(op_key),
+            y_scale,
+            y_zero,
+        ],
+    )
+    .with_name("q")
+}
+
+/// Inputs of the QDQ compute pattern, in the order expected by the fused
+/// operator.
+const QDQ_PATTERN_INPUTS: &[&str] = &[
+    "x", "x_scale", "x_zero", "w", "w_scale", "w_zero", "y_scale", "y_zero",
+];
+
+/// Fuses `QuantizeLinear(Conv(DequantizeLinear(x), DequantizeLinear(w)))` into
+/// a `QLinearConv` operator.
+pub struct QLinearConvFusion {
+    pub with_bias: bool,
+}
+
+impl PatternFusion for QLinearConvFusion {
+    type Operator = QLinearConv;
+
+    fn name(&self) -> &str {
+        "QLinearConvFusion"
+    }
+
+    fn pattern(&self) -> Pattern {
+        qdq_compute_pattern("Conv", "conv", self.with_bias)
+    }
+
+    fn inputs(&self) -> &[&str] {
+        QDQ_PATTERN_INPUTS
+    }
+
+    fn unused_inputs(&self) -> &[&str] {
+        if self.with_bias { &["float_bias"] } else { &[] }
+    }
+
+    fn extra_constant(&self, m: &Match, g: &Graph) -> Result<Option<Constant>, FusionError> {
+        if !self.with_bias {
+            return Ok(None);
+        }
+        let err =
+            || FusionError::CheckFailed("bias must be exactly representable at accumulator scale");
+        let biases = g
+            .get_vector::<f32>(m.node_id("float_bias").unwrap())
+            .ok_or_else(err)?;
+        let scales = |name| {
+            let id = m.node_id(name).unwrap();
+            g.get_scalar::<f32>(id)
+                .map(|x| vec![x])
+                .or_else(|| g.get_vector::<f32>(id).map(|s| s.to_vec()))
+                .ok_or_else(err)
+        };
+        let xs = scales("x_scale")?;
+        let ws = scales("w_scale")?;
+        if xs.len() != 1 || !(ws.len() == 1 || ws.len() == biases.len()) {
+            return Err(err());
+        }
+        let mut codes = Vec::with_capacity(biases.len());
+        for (i, &b) in biases.iter().enumerate() {
+            let q = f64::from(b) / (f64::from(xs[0]) * f64::from(ws[i % ws.len()]));
+            if q.fract() != 0. || !(f64::from(i32::MIN)..=f64::from(i32::MAX)).contains(&q) {
+                return Err(err());
+            }
+            codes.push(q as i32);
+        }
+        Ok(Some(
+            ConstantNode::new(
+                None,
+                ConstantNodeData::Arc(ArcTensor::from_data(&[codes.len()], Arc::new(codes))),
+            )
+            .into(),
+        ))
+    }
+
+    fn maybe_fuse(&self, pat_match: &Match, graph: &Graph) -> Result<Self::Operator, FusionError> {
+        let conv: &Conv = graph
+            .get_operator(pat_match.node_id("conv").unwrap())
+            .ok_or(FusionError::CheckFailed("expected Conv operator"))?;
+        let w_dq: &DequantizeLinear = graph
+            .get_operator(pat_match.node_id("w_dq").unwrap())
+            .ok_or(FusionError::CheckFailed(
+                "expected DequantizeLinear operator",
+            ))?;
+
+        check_qlinear_params(
+            graph,
+            pat_match,
+            WeightQuantAxis::ConvOutChannels,
+            w_dq.axis,
+        )?;
+        check_quantize_output_dtype(graph, pat_match)?;
+
+        Ok(QLinearConv {
+            groups: conv.groups,
+            dilations: conv.dilations.clone(),
+            padding: conv.padding.clone(),
+            strides: conv.strides.clone(),
+        })
+    }
+}
+
+/// Fuses `QuantizeLinear(MatMul(DequantizeLinear(a), DequantizeLinear(b)))`
+/// into a `QLinearMatMul` operator.
+pub struct QLinearMatMulFusion {}
+
+impl PatternFusion for QLinearMatMulFusion {
+    type Operator = QLinearMatMul;
+
+    fn name(&self) -> &str {
+        "QLinearMatMulFusion"
+    }
+
+    fn pattern(&self) -> Pattern {
+        qdq_compute_pattern("MatMul", "matmul", false)
+    }
+
+    fn inputs(&self) -> &[&str] {
+        QDQ_PATTERN_INPUTS
+    }
+
+    fn maybe_fuse(&self, pat_match: &Match, graph: &Graph) -> Result<Self::Operator, FusionError> {
+        let w_dq: &DequantizeLinear = graph
+            .get_operator(pat_match.node_id("w_dq").unwrap())
+            .ok_or(FusionError::CheckFailed(
+                "expected DequantizeLinear operator",
+            ))?;
+
+        check_qlinear_params(graph, pat_match, WeightQuantAxis::MatMulColumns, w_dq.axis)?;
+        check_quantize_output_dtype(graph, pat_match)?;
+
+        Ok(QLinearMatMul {})
+    }
+}
