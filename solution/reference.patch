+                    put(g, 5, tensors),
+                    1,
+                    [pack(nested(n, lambda k, s: relocate(s))) for n in child(g, 1)],
+                )
+
+            result = relocate(g)
+        if not side.stat().st_size:
+            side.unlink()
+        data = pack(put(model, 7, [pack(result)]))
+        out.write_bytes(data)
+        return len(data) + (side.stat().st_size if side.exists() else 0)
+
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("action", choices=["calibrate", "quantize", "optimize"])
+    p.add_argument("model", type=Path)
+    p.add_argument("-o", required=True, type=Path)
+    p.add_argument("--sample", action="append", default=[])
+    p.add_argument("--profile", action="append", default=[])
+    p.add_argument("--validate", action="append", default=[])
+    p.add_argument("--max-bytes", type=int)
+    p.add_argument("--max-error", type=float)
+    p.add_argument("--format", choices=["qoperator", "qdq"])
+    a = p.parse_args()
+    model = message(a.model.read_bytes())
+    graph = message(one(model, 7))
+    base = a.model.resolve().parent
+    ranges = {}
+    with (
+        tempfile.TemporaryDirectory() as d,
+        tempfile.TemporaryDirectory(dir=a.o.resolve().parent) as stage,
+    ):
+        tmp = Path(d)
+        out = Path(stage) / a.o.name
+        if a.action != "optimize":
+            ident = fingerprint(model, base)
+            for f in a.profile:
+                profile = json.loads(Path(f).read_text())
+                if profile["model"] != ident:
+                    raise ValueError("incompatible calibration profile")
+                for k, v in profile["ranges"].items():
+                    update(ranges, k, v)
+            ev = Evaluator(model, base, tmp)
+            for f in a.sample:
+                ev.run(graph, read_sample(f), ranges=ranges)
+            if a.action == "calibrate":
+                out.write_text(json.dumps({"model": ident, "ranges": ranges}, sort_keys=True))
+                out.replace(a.o)
+                return
+            if not a.format:
+                raise ValueError("--format is required")
+        budget = a.max_bytes is not None or a.max_error is not None
+        if budget and (a.max_bytes is None or a.max_error is None or not a.validate):
+            raise ValueError("budgeted export requires byte, error, and validation arguments")
+        keys = sorted({k[:-2] for k in ranges if k.endswith("/2")})
+        expected = [ev.run(graph, read_sample(f)) for f in a.validate] if budget else []
+        candidates = (
+            (itertools.combinations(keys, n) for n in range(len(keys), -1, -1))
+            if budget
+            else [[keys]]
+        )
+        for mask in itertools.chain.from_iterable(candidates):
+            ex = Export(base, tmp, ranges, a.format, set(mask), model)
+            g = optimize_graph(graph, base, ex.fresh) if a.action == "optimize" else ex.graph(graph)
+            size = ex.bundle(model, g, out)
+            if budget:
+                if size > a.max_bytes:
+                    continue
+                result = message(out.read_bytes())
+                evaluator = Evaluator(result, out.parent, tmp)
+                suitable = True
+                for file, ref in zip(a.validate, expected):
+                    got = evaluator.run(message(one(result, 7)), read_sample(file))
+                    for x, y in zip(ref, got):
+                        if x[:2] != y[:2] or any(
+                            not (abs(p - q) <= a.max_error) for p, q in zip(values(x), values(y))
+                        ):
+                            suitable = False
+                            break
+                    if not suitable:
+                        break
+                if not suitable:
+                    continue
+            side = out.with_name(out.name + ".data")
+            if side.exists():
+                side.replace(a.o.with_name(side.name))
+            out.replace(a.o)
+            return
+        raise ValueError("infeasible byte and error limits")
+
+
+try:
+    main()
+except (OSError, ValueError, KeyError, subprocess.SubprocessError) as error:
+    sys.exit(str(error))
