+/// Scales used when requantizing the int32 output of a quantized operator
+/// such as `QLinearConv` or `QLinearMatMul`.
+///
+/// Each scale combines the input, weight and output scales for the operator
+/// (`x_scale * w_scale / y_scale`).
+#[derive(Clone, Debug, PartialEq)]
+pub(crate) enum ChannelScales {
+    /// A single scale applied to all elements.
+    Scalar(f32),
+    /// One scale per channel along an axis of the output.
+    Vector(Vec<f32>),
+}
+
+/// Validate that a quantization scale is positive and finite.
+fn check_scale_value(scale: f32) -> Result<(), OpError> {
+    if !scale.is_finite() || scale <= 0. {
+        return Err(OpError::invalid_value("scale must be positive and finite"));
+    }
+    Ok(())
+}
+
+/// Extract a per-tensor quantization scale.
+///
+/// The scale must be a scalar or single-element vector. Multi-element scales
+/// are rejected since activation and output quantization for the QLinear
+/// operators must be per-tensor.
+pub(crate) fn per_tensor_scale(scale: TensorView<f32>) -> Result<f32, OpError> {
+    let Some(&scale) = scale.item() else {
+        return Err(OpError::unsupported_value(
+            "only per-tensor scales are supported for this input",
+        ));
+    };
+    check_scale_value(scale)?;
+    Ok(scale)
+}
+
+/// Extract a per-tensor zero point.
+///
+/// The zero point must be a scalar or single-element vector.
+pub(crate) fn per_tensor_zero_point<T: Copy>(zero_point: TensorView<T>) -> Result<T, OpError> {
+    zero_point.item().copied().ok_or(OpError::unsupported_value(
+        "only per-tensor zero points are supported for this input",
+    ))
+}
+
+/// Validate weight scale and zero point granularity and extract the scale(s).
+///
+/// The scale and zero point must either both be per-tensor (scalar or
+/// single-element) or both be per-channel (1-D vectors with `channels`
+/// elements). The zero point is only validated here; it should be passed
+/// through to the integer compute kernel.
+pub(crate) fn weight_quant_params<T>(
+    scale: TensorView<f32>,
+    zero_point: Option<&TensorView<T>>,
+    channels: usize,
+) -> Result<ChannelScales, OpError> {
+    if let Some(&scale) = scale.item() {
+        // Per-tensor scale.
+        if let Some(zp) = zero_point
+            && zp.item().is_none()
+        {
+            return Err(OpError::invalid_value(
+                "scale and zero point must have the same granularity",
+            ));
+        }
+        check_scale_value(scale)?;
+        Ok(ChannelScales::Scalar(scale))
+    } else if let Ok(scales) = scale.into_rank::<1>() {
+        // Per-channel scales.
+        check_eq!(
+            scales.size(0),
+            channels,
+            "scale length does not match channel count"
+        )?;
+        if let Some(zp) = zero_point
+            && (zp.ndim() != 1 || zp.size(0) != channels)
+        {
+            return Err(OpError::invalid_value(
+                "scale and zero point must have the same granularity",
+            ));
+        }
+        for &scale in scales.iter() {
+            check_scale_value(scale)?;
+        }
+        Ok(ChannelScales::Vector(scales.to_vec()))
+    } else {
+        Err(OpError::unsupported_value(
+            "scale must be a scalar or 1-D vector",
+        ))
+    }
+}
+
+/// Requantize an int32 accumulator tensor to the output type of a quantized
+/// operator.
+///
+/// Each output element is `saturate(round_ties_even(acc * scale) + zero_point)`.
+/// For per-channel scales, `channel_axis` specifies the axis along which the
+/// scales vary.
+pub(crate) fn requantize_int32<T>(
+    pool: &BufferPool,
+    acc: Tensor<i32>,
+    scales: &ChannelScales,
+    channel_axis: usize,
+    zero_point: T,
+) -> Result<Tensor<T>, OpError>
+where
+    T: Copy + Default + Send + Sync + Scalar + 'static,
+    f32: Quantize<T>,
+{
+    match scales {
+        ChannelScales::Scalar(scale) => {
+            Ok(acc.map_in(pool, |x| (*x as f32).quantize(*scale, zero_point)))
+        }
+        ChannelScales::Vector(scales) => {
+            check_eq!(
+                scales.len(),
+                acc.size(channel_axis),
+                "scale length does not match channel count"
+            )?;
+            let mut output = Tensor::uninit_in(pool, acc.shape());
+            output
+                .axis_iter_mut(channel_axis)
+                .into_par_iter()
+                .zip(acc.axis_iter(channel_axis))
+                .zip(scales.par_iter())
+                .for_each(|((mut out_slice, in_slice), &scale)| {
+                    for (y, &x) in out_slice.iter_mut().zip(in_slice.iter()) {
+                        y.write((x as f32).quantize(scale, zero_point));
+                    }
+                });
+
+            // Safety: All elements are initialized
+            Ok(unsafe { output.assume_init() })
+        }
+    }
+}
