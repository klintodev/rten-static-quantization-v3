+        padded
+            .slice_mut((.., .., pad_left..pad_left + w))
+            .copy_from(&input);
+        padded
+    } else {
+        let [n, c, h, w]: [usize; 4] = input.shape().try_into().expect("expected NCHW input");
+        let mut padded = Tensor::full(
+            &[n, c, h + pad_top + pad_bottom, w + pad_left + pad_right],
+            pad_value,
+        );
+        padded
+            .slice_mut((.., .., pad_top..pad_top + h, pad_left..pad_left + w))
+            .copy_from(&input);
+        padded
+    }
