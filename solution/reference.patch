+        input: TensorView<X>,
+        input_zero: Option<TensorView<X>>,
+        kernel: TensorView<W>,
+        kernel_zero: Option<TensorView<W>>,
+    ) -> Result<Value, OpError>
+    where
+        X: Copy + Default + ShiftCast<i8>,
+        W: Copy + Default + Into<i16> + ShiftCast<u8> + 'static,
+        for<'a> TensorView<'a, X>: ShiftCast<CowTensor<'a, i8>>,
+        for<'a> TensorView<'a, W>: ShiftCast<CowTensor<'a, u8>>,
+    {
+        let inputs = ctx.inputs();
+        let x_scale = per_tensor_scale(inputs.require_as(1)?)?;
+        let w_scale: TensorView<f32> = inputs.require_as(4)?;
+        let y_scale = per_tensor_scale(inputs.require_as(6)?)?;
+        let y_zero_point = inputs.get(7);
+        let bias: Option<NdTensorView<i32, 1>> = inputs.get_as(8)?;
+
+        let out_chans = if kernel.ndim() >= 1 {
+            kernel.size(0)
+        } else {
+            0
+        };
+        let w_scales = weight_quant_params(w_scale, kernel_zero.as_ref(), out_chans)?;
+        if let Some(zp) = input_zero.as_ref() {
+            per_tensor_zero_point(zp.view())?;
+        }
+
+        let acc = conv_integer_with_bias(
+            ctx.pool(),
+            input,
+            kernel,
+            bias,
+            self.padding.clone(),
+            self.groups,
+            &self.strides,
+            &self.dilations,
+            input_zero,
+            kernel_zero,
+        )?;
+
+        let combined_scales = match &w_scales {
+            ChannelScales::Scalar(w_scale) => ChannelScales::Scalar(x_scale * w_scale / y_scale),
+            ChannelScales::Vector(w_scales) => {
+                ChannelScales::Vector(w_scales.iter().map(|ws| x_scale * ws / y_scale).collect())
+            }
+        };
+
+        // Requantize the accumulator along the output channel axis.
+        match y_zero_point {
+            Some(ValueView::UInt8Tensor(zp)) => {
+                let zp = per_tensor_zero_point(zp)?;
+                requantize_int32(ctx.pool(), acc, &combined_scales, 1, zp).map(Value::from)
+            }
+            Some(ValueView::Int8Tensor(zp)) => {
+                let zp = per_tensor_zero_point(zp)?;
+                requantize_int32(ctx.pool(), acc, &combined_scales, 1, zp).map(Value::from)
+            }
+            None => requantize_int32(ctx.pool(), acc, &combined_scales, 1, 0u8).map(Value::from),
+            _ => Err(OpError::UnsupportedType),
+        }
+    }
+}
