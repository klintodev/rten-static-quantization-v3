+
+        let ok_params: [Option<ValueView>; 6] = [
+            Some(a_scale_ok.view().into()),
+            Some(a_zp_ok.view().into()),
+            Some(b_scale_ok.view().into()),
+            Some(b_zp_ok.view().into()),
+            Some(y_scale_ok.view().into()),
+            Some(y_zp_ok.view().into()),
+        ];
+
+        // Valid case.
+        assert!(run(&ok_params).is_ok());
+
+        // Multi-element activation scale.
