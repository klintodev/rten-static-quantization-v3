+/// For 3D inputs the top and bottom padding must be zero.
+fn pad_spatial_dims<X: Copy>(input: TensorView<X>, padding: [usize; 4], pad_value: X) -> Tensor<X> {
+    let [pad_top, pad_left, pad_bottom, pad_right] = padding;
+    if input.ndim() == 3 {
+        let [n, c, w]: [usize; 3] = input.shape().try_into().expect("expected NCW input");
