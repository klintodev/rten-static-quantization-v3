+impl Operator for QLinearConv {
+    fn name(&self) -> &str {
+        "QLinearConv"
+    }
+
+    fn max_inputs(&self) -> Option<usize> {
+        Some(9)
+    }
+
+    fn run(&self, ctx: &OpRunContext) -> Result<OutputList, OpError> {
+        let inputs = ctx.inputs();
+        let input = inputs.require(0)?;
+        let kernel = inputs.require(3)?;
+
+        macro_rules! qlinear_conv {
+            ($x:expr, $x_ty:ty, $w:expr, $w_ty:ty) => {{
+                let input_zero: Option<TensorView<$x_ty>> = inputs.get_as(2)?;
+                let kernel_zero: Option<TensorView<$w_ty>> = inputs.get_as(5)?;
+                self.run_typed(ctx, $x, input_zero, $w, kernel_zero)
+            }};
+        }
+
+        let result = match (input, kernel) {
+            (ValueView::UInt8Tensor(x), ValueView::UInt8Tensor(w)) => {
+                qlinear_conv!(x, u8, w, u8)
+            }
+            (ValueView::UInt8Tensor(x), ValueView::Int8Tensor(w)) => {
+                qlinear_conv!(x, u8, w, i8)
+            }
+            (ValueView::Int8Tensor(x), ValueView::UInt8Tensor(w)) => {
+                qlinear_conv!(x, i8, w, u8)
+            }
+            (ValueView::Int8Tensor(x), ValueView::Int8Tensor(w)) => {
+                qlinear_conv!(x, i8, w, i8)
+            }
+            _ => Err(OpError::UnsupportedType),
+        };
+        result.into_op_result()
+    }
+
+    fn output_types(&self, _ctx: &OutputTypesContext) -> Option<OutputTypeList> {
+        Some([OutputType::CopyFromInput(7)].into())
+    }
+
+    fn as_infer_shapes(&self) -> Option<&dyn InferShapes> {
+        Some(self)
+    }
+}
