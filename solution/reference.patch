+        let y_zp_ok = Tensor::from(0u8);
+
+        let run = |params: &[Option<ValueView>; 6]| -> Result<Tensor<u8>, OpError> {
+            let inputs: [Option<ValueView>; 8] = [
+                Some(a.view().into()),
+                params[0].clone(),
+                params[1].clone(),
+                Some(b.view().into()),
+                params[2].clone(),
+                params[3].clone(),
+                params[4].clone(),
+                params[5].clone(),
+            ];
+            op.run_simple(InputList::from_optional(&inputs))
