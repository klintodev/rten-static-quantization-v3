+#[test]
+fn test_fuse_qdq_matmul_dynamic_weights() {
+    // The weight DQ input is a dynamic value rather than a constant.
+    //
+    // Per-tensor weight parameters do not require knowing the weight shape,
+    // so the fusion still applies.
+    let graph = qdq_matmul_expr(Expr::value("a"), Expr::value("w"), &valid_qdq_params())
+        .build_graph(["a", "w"]);
+    let graph = optimize_graph(graph).unwrap();
+    let (_, op) = graph.get_source_node(graph.output_ids()[0]).unwrap();
+    assert_eq!(op.operator().name(), "QLinearMatMul");
+
+    // With per-channel weight parameters the weight rank must be known, so
+    // the fusion does not apply for dynamic weights with unknown rank.
+    let params = QdqParams {
+        w_scale: Tensor::from([0.02, 0.03]),
+        w_zero: Tensor::from([0i8, 1]),
+        w_dq_axis: 1,
+        ..valid_qdq_params()
+    };
+    let graph =
+        qdq_matmul_expr(Expr::value("a"), Expr::value("w"), &params).build_graph(["a", "w"]);
+    let graph = optimize_graph(graph).unwrap();
+    let (_, op) = graph.get_source_node(graph.output_ids()[0]).unwrap();
+    assert_eq!(op.operator().name(), "QuantizeLinear");
+}
