diff --git a/rten-cli/src/quant.rs b/rten-cli/src/quant.rs
new file mode 100644
index 0000000000000000000000000000000000000000..0b39062349ec3bde99c0636546960c5ead012202
--- /dev/null
+++ b/rten-cli/src/quant.rs
@@ -0,0 +1,102 @@
+//! Numerical primitives used by the streaming ONNX transformation driver.
+use rten::{ModelOptions, Value};
+use rten_serialize::View;
+use rten_tensor::AsView;
+use std::error::Error;
+use std::fs::File;
+use std::io::{BufReader, BufWriter, Read, Seek, SeekFrom, Write};
+use std::path::Path;
+use std::process::{Command, ExitCode};
+
+fn evaluate(args: &[String]) -> Result<(), Box<dyn Error>> {
+    let mut opts = ModelOptions::with_all_ops();
+    opts.enable_optimization(false);
+    opts.prepack_weights(false);
+    let model = unsafe { opts.load_mmap(&args[0]) }?;
+    let feed = super::read_safetensors(Path::new(&args[1]))?;
+    let inputs = feed
+        .iter()
+        .map(|(n, v)| Ok((model.node_id(n)?, v.as_view().into())))
+        .collect::<Result<Vec<_>, rten::RunError>>()?;
+    let out = model.run(inputs, model.output_ids(), None)?;
+    let mut values = Vec::new();
+    for (&id, v) in model.output_ids().iter().zip(&out) {
+        let name = model.node_info(id).unwrap().name().unwrap().to_owned();
+        let view: View = match v {
+            Value::FloatTensor(t) => t.view().into(),
+            Value::Int32Tensor(t) => t.view().into(),
+            Value::Int8Tensor(t) => t.view().into(),
+            Value::UInt8Tensor(t) => t.view().into(),
+            _ => return Err("unsupported output".into()),
+        };
+        values.push((name, view));
+    }
+    rten_serialize::safetensors::write_to_file(&args[2], values)?;
+    Ok(())
+}
+
+fn weights(args: &[String]) -> Result<(), Box<dyn Error>> {
+    let mut input = BufReader::new(File::open(&args[0])?);
+    input.seek(SeekFrom::Start(args[1].parse()?))?;
+    let mut bytes: usize = args[2].parse()?;
+    let mut peak = 0.0f32;
+    let mut buffer = vec![0; 262144];
+    let mut output = args
+        .get(3)
+        .map(File::create)
+        .transpose()?
+        .map(BufWriter::new);
+    let scale: f32 = args.get(4).map(|s| s.parse()).transpose()?.unwrap_or(1.);
+    while bytes > 0 {
+        let n = bytes.min(buffer.len());
+        if n % 4 != 0 {
+            return Err("invalid float32 initializer length".into());
+        }
+        input.read_exact(&mut buffer[..n])?;
+        for chunk in buffer[..n].chunks_exact(4) {
+            let x = f32::from_le_bytes(chunk.try_into()?);
+            if !x.is_finite() {
+                return Err("non-finite weight".into());
+            }
+            peak = peak.max(x.abs());
+            if let Some(out) = output.as_mut() {
+                out.write_all(&[(x / scale).round_ties_even().clamp(-127., 127.) as i8 as u8])?;
+            }
+        }
+        bytes -= n;
+    }
+    if let Some(out) = output.as_mut() {
+        out.flush()?;
+    }
+    println!("{peak}");
+    Ok(())
+}
+
+pub fn dispatch() -> Option<ExitCode> {
+    let args: Vec<_> = std::env::args().skip(1).collect();
+    let action = args.first()?.as_str();
+    let result = match action {
+        "_quant_eval" => evaluate(&args[1..]),
+        "_quant_weight" => weights(&args[1..]),
+        "quantize" | "calibrate" | "optimize" => {
+            let mut cmd = Command::new("python3");
+            cmd.arg("-c")
+                .arg(include_str!("quantize.py"))
+                .arg(std::env::current_exe().unwrap())
+                .args(args);
+            match cmd.status() {
+                Ok(s) if s.success() => Ok(()),
+                Ok(_) => return Some(ExitCode::FAILURE),
+                Err(e) => Err(e.into()),
+            }
+        }
+        _ => return None,
+    };
+    Some(match result {
+        Ok(()) => ExitCode::SUCCESS,
+        Err(e) => {
+            eprintln!("{e}");
+            ExitCode::FAILURE
+        }
+    })
+}
