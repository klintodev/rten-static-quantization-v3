+#[test]
+fn test_fuse_qdq_conv() {
+    #[derive(Debug)]
+    struct Case {
+        params: QdqParams,
+        expected_op: &'static str,
+    }
+
+    // Weight constants have 3 output channels.
+    let w = || Expr::constant(Tensor::<i8>::zeros(&[3, 2, 3, 3]));
+
+    let cases = [
+        // Per-tensor parameters.
+        Case {
+            params: valid_qdq_params(),
+            expected_op: "QLinearConv",
+        },
+        // Per-channel weights, quantization axis 0.
+        Case {
+            params: QdqParams {
+                w_scale: Tensor::from([0.02, 0.03, 0.04]),
+                w_zero: Tensor::from([0i8, 1, 2]),
+                w_dq_axis: 0,
+                ..valid_qdq_params()
+            },
+            expected_op: "QLinearConv",
+        },
+        // Per-channel weights, quantization axis 0 specified as -4.
+        Case {
+            params: QdqParams {
+                w_scale: Tensor::from([0.02, 0.03, 0.04]),
+                w_zero: Tensor::from([0i8, 1, 2]),
+                w_dq_axis: -4,
+                ..valid_qdq_params()
+            },
+            expected_op: "QLinearConv",
+        },
+        // Per-channel weights along an incorrect quantization axis. The scale
+        // length matches the axis size, so the DequantizeLinear itself is
+        // valid, but the axis is not the output channel axis.
+        Case {
+            params: QdqParams {
+                w_scale: Tensor::from([0.02, 0.03]),
+                w_zero: Tensor::from([0i8, 1]),
+                w_dq_axis: 1,
+                ..valid_qdq_params()
+            },
+            expected_op: "QuantizeLinear",
+        },
+        // Per-channel activation scale.
+        Case {
+            params: QdqParams {
+                x_scale: Tensor::from([0.1, 0.2]),
+                ..valid_qdq_params()
+            },
+            expected_op: "QuantizeLinear",
+        },
+        // Per-channel activation zero point.
+        Case {
+            params: QdqParams {
+                x_zero: Tensor::from([0u8, 1]),
+                ..valid_qdq_params()
+            },
+            expected_op: "QuantizeLinear",
+        },
+        // Per-channel output zero point.
+        Case {
+            params: QdqParams {
+                y_zero: Tensor::from([0u8, 1]),
+                ..valid_qdq_params()
+            },
+            expected_op: "QuantizeLinear",
+        },
+        // Zero output scale.
+        Case {
+            params: QdqParams {
+                y_scale: Tensor::from(0.),
+                ..valid_qdq_params()
+            },
+            expected_op: "QuantizeLinear",
+        },
+        // QuantizeLinear output type matching the zero point type.
+        Case {
+            params: QdqParams {
+                q_output_dtype: Some(DataType::UInt8),
+                ..valid_qdq_params()
+            },
+            expected_op: "QLinearConv",
+        },
+        // QuantizeLinear output type not matching the zero point type.
+        Case {
+            params: QdqParams {
+                q_output_dtype: Some(DataType::Int8),
+                ..valid_qdq_params()
+            },
+            expected_op: "QuantizeLinear",
+        },
+    ];
+
+    cases.test_each(|case| {
+        let graph = qdq_conv_expr(Expr::value("x"), w(), &case.params).build_graph(["x"]);
+        let graph = optimize_graph(graph).unwrap();
+        let (_, op) = graph.get_source_node(graph.output_ids()[0]).unwrap();
+        assert_eq!(op.operator().name(), case.expected_op);
+
+        // Check attributes are propagated to the fused operator.
+        if case.expected_op == "QLinearConv" {
+            let fused = op.operator().downcast_ref::<QLinearConv>().unwrap();
+            assert_eq!(fused.strides, &[2, 2]);
+        }
+    })
+}
