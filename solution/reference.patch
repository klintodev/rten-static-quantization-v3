+/// Parameters of a `QuantizeLinear(Op(DequantizeLinear, DequantizeLinear))`
+/// (QDQ) pattern around a Conv or MatMul.
+#[derive(Debug)]
+struct QdqParams {
+    x_scale: Tensor<f32>,
+    x_zero: Tensor<u8>,
+    w_scale: Tensor<f32>,
+    w_zero: Tensor<i8>,
+    y_scale: Tensor<f32>,
+    y_zero: Tensor<u8>,
+    w_dq_axis: isize,
+    q_output_dtype: Option<DataType>,
+}
+
+/// Valid per-tensor QDQ parameters.
+fn valid_qdq_params() -> QdqParams {
+    QdqParams {
+        x_scale: Tensor::from(0.1),
+        x_zero: Tensor::from(0u8),
+        w_scale: Tensor::from(0.02),
+        w_zero: Tensor::from(0i8),
+        y_scale: Tensor::from(0.15),
+        y_zero: Tensor::from(0u8),
+        w_dq_axis: 0,
+        q_output_dtype: None,
+    }
+}
+
+/// Build a `QuantizeLinear(Conv(DequantizeLinear(x), DequantizeLinear(w)))` expression.
+fn qdq_conv_expr(x: Expr, w: Expr, params: &QdqParams) -> Expr {
+    let dq_x = x.apply(
+        DequantizeLinear { axis: -1 },
+        &[
+            Expr::constant(params.x_scale.clone()),
+            Expr::constant(params.x_zero.clone()),
+        ],
+        &[OutputMeta::NoMeta],
+    );
+    let dq_w = w.apply(
+        DequantizeLinear {
+            axis: params.w_dq_axis,
+        },
+        &[
+            Expr::constant(params.w_scale.clone()),
+            Expr::constant(params.w_zero.clone()),
+        ],
+        &[OutputMeta::NoMeta],
+    );
+    dq_x.apply(
+        Conv {
+            groups: 1,
+            dilations: vec![1, 1],
+            padding: Padding::zero::<2>(),
+            strides: vec![2, 2],
+        },
+        &[dq_w],
+        &[OutputMeta::NoMeta],
+    )
+    .apply(
+        QuantizeLinear {
+            axis: -1,
+            output_dtype: params.q_output_dtype,
+        },
+        &[
+            Expr::constant(params.y_scale.clone()),
+            Expr::constant(params.y_zero.clone()),
+        ],
+        &[OutputMeta::NoMeta],
+    )
+}
