@@ -0,0 +1,46 @@
+use rten::{ModelOptions, Value};
+use rten_tensor::{AsView, Tensor};
+use std::{fs, process::Command};
+
+#[test]
+fn both_exports_reload_on_held_out_input() {
+    let root = std::env::temp_dir().join(format!(
+        "rten-round-trip-{}-{}",
+        std::process::id(),
+        fastrand::u64(..)
+    ));
+    fs::create_dir(&root).unwrap();
+    let original = root.join("linear.onnx");
+    fs::write(&original, include_bytes!("data/linear.onnx")).unwrap();
+    let sample = root.join("calibration.st");
+    let calibration = Tensor::from_data(&[1, 2], vec![-2f32, 2.]);
+    rten_serialize::safetensors::write_to_file(&sample, [("x", calibration.view())]).unwrap();
+    for format in ["qdq", "qoperator"] {
+        let out = root.join(format!("{format}.onnx"));
+        let status = Command::new(env!("CARGO_BIN_EXE_rten"))
+            .arg("quantize")
+            .arg(&original)
+            .arg("--format")
+            .arg(format)
+            .arg("--sample")
+            .arg(&sample)
+            .arg("-o")
+            .arg(&out)
+            .status()
+            .unwrap();
+        assert!(status.success());
+        let mut opts = ModelOptions::with_all_ops();
+        opts.enable_optimization(false);
+        let m = opts.load_file(out).unwrap();
+        let input = Value::from(Tensor::from_data(&[1, 2], vec![0.5f32, -1.25]));
+        let got = m
+            .run_one(input.into(), None)
+            .unwrap()
+            .into_tensor::<f32>()
+            .unwrap();
+        for (a, b) in got.iter().zip([1.25f32, 0.5]) {
+            assert!((a - b).abs() < 0.04, "{format}: {a} vs {b}");
+        }
+    }
+    fs::remove_dir_all(root).unwrap();
+}
