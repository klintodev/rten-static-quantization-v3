+        let result: Tensor<u8> =
+            requantize_int32(&pool, acc, &ChannelScales::Scalar(0.5), 0, 0u8).unwrap();
+        assert_eq!(result, Tensor::from([1, 2, 2, 0, 255, 0]));
+
+        // Per-tensor scale with i8 output and non-zero zero point.
+        let acc = Tensor::from([2, 3, 1000, -1000]);
+        let result: Tensor<i8> =
+            requantize_int32(&pool, acc, &ChannelScales::Scalar(0.5), 0, 1i8).unwrap();
+        assert_eq!(result, Tensor::from([2, 3, 127, -128]));
+
+        // Per-channel scales along axis 0.
+        let acc = Tensor::from([[2, 4], [6, 8]]);
+        let result: Tensor<i8> =
+            requantize_int32(&pool, acc, &ChannelScales::Vector(vec![0.5, 0.25]), 0, 0i8).unwrap();
+        assert_eq!(result, Tensor::from([[1, 2], [2, 2]]));
+
+        // Per-channel scales along axis 1.
+        let acc = Tensor::from([[2, 4], [6, 8]]);
+        let result: Tensor<i8> =
+            requantize_int32(&pool, acc, &ChannelScales::Vector(vec![0.5, 0.25]), 1, 0i8).unwrap();
+        assert_eq!(result, Tensor::from([[1, 1], [3, 2]]));
+
+        // Scale length does not match channel count.
+        let acc = Tensor::from([[2, 4], [6, 8]]);
+        let result: Result<Tensor<i8>, _> = requantize_int32(
+            &pool,
+            acc,
+            &ChannelScales::Vector(vec![0.5, 0.25, 0.5]),
+            0,
+            0i8,
+        );
+        assert_eq!(
+            result.err(),
+            Some(OpError::incompatible_input_shapes(
+                "scale length does not match channel count"
+            ))
+        );
+    }
 }
