+/// QLinearMatMul operator.
+///
+/// This multiplies quantized matrices. The zero-point adjusted products
+/// `(a - a_zero_point) * (b - b_zero_point)` are accumulated in int32 and the
+/// result is requantized to the output type as
+/// `saturate(round_ties_even(acc * a_scale * b_scale / y_scale) + y_zero_point)`.
+///
+/// The activation and output scales and zero points must be per-tensor (scalar
+/// or single-element vectors). The weight scale and zero point must have
+/// matching granularity: either both per-tensor or both per-column, with one
+/// entry per column of `b`.
+///
+/// The output type is given by the type of the `y_zero_point` input, or
+/// defaults to u8 if it is omitted.
+///
+/// See <https://onnx.ai/onnx/operators/onnx__QLinearMatMul.html>.
+#[derive(Debug, Default)]
+pub struct QLinearMatMul {}
+
+impl QLinearMatMul {
+    fn run_typed<LhsT, RhsT>(
+        &self,
+        ctx: &OpRunContext,
+        a: TensorView<LhsT>,
+        a_zero_point: Option<TensorView<LhsT>>,
+        b: TensorView<RhsT>,
+        b_zero_point: Option<TensorView<RhsT>>,
+    ) -> Result<Value, OpError>
+    where
+        LhsT: Copy + Default + Into<i16> + ShiftCast<u8> + 'static,
+        RhsT: Copy + Default + ShiftCast<i8> + 'static,
+        for<'a> TensorView<'a, LhsT>: ShiftCast<CowTensor<'a, u8>>,
+        for<'a> TensorView<'a, RhsT>: ShiftCast<CowTensor<'a, i8>>,
+    {
+        let inputs = ctx.inputs();
+        let a_scale = per_tensor_scale(inputs.require_as(1)?)?;
+        let b_scale: TensorView<f32> = inputs.require_as(4)?;
+        let y_scale = per_tensor_scale(inputs.require_as(6)?)?;
+        let y_zero_point = inputs.get(7);
+
+        let b_cols = if b.ndim() > 1 {
+            b.size(b.ndim() - 1)
+        } else {
+            1
+        };
+        let b_scales = weight_quant_params(b_scale, b_zero_point.as_ref(), b_cols)?;
+        if let Some(zp) = a_zero_point.as_ref() {
+            per_tensor_zero_point(zp.view())?;
+        }
+
+        let packed_b = inputs
+            .get_prepacked(3)
+            .and_then(|packed| packed.try_into().ok());
+
+        let acc = matmul_integer(ctx.pool(), a, b, a_zero_point, b_zero_point, packed_b)?;
+
+        let combined_scales = match &b_scales {
+            ChannelScales::Scalar(b_scale) => ChannelScales::Scalar(a_scale * b_scale / y_scale),
+            ChannelScales::Vector(b_scales) => {
+                ChannelScales::Vector(b_scales.iter().map(|bs| a_scale * bs / y_scale).collect())
+            }
+        };
+
+        // Requantize the accumulator along the last (column) axis.
+        let channel_axis = acc.ndim().saturating_sub(1);
+        match y_zero_point {
+            Some(ValueView::UInt8Tensor(zp)) => {
+                let zp = per_tensor_zero_point(zp)?;
+                requantize_int32(ctx.pool(), acc, &combined_scales, channel_axis, zp)
+                    .map(Value::from)
+            }
+            Some(ValueView::Int8Tensor(zp)) => {
+                let zp = per_tensor_zero_point(zp)?;
+                requantize_int32(ctx.pool(), acc, &combined_scales, channel_axis, zp)
+                    .map(Value::from)
+            }
+            None => requantize_int32(ctx.pool(), acc, &combined_scales, channel_axis, 0u8)
+                .map(Value::from),
+            _ => Err(OpError::UnsupportedType),
+        }
+    }
+}
+
+impl Operator for QLinearMatMul {
+    fn name(&self) -> &str {
+        "QLinearMatMul"
+    }
+
+    fn max_inputs(&self) -> Option<usize> {
+        Some(8)
+    }
+
+    fn run(&self, ctx: &OpRunContext) -> Result<OutputList, OpError> {
+        let inputs = ctx.inputs();
+        let a = inputs.require(0)?;
+        let b = inputs.require(3)?;
+
+        macro_rules! qlinear_matmul {
+            ($a:expr, $a_ty:ty, $b:expr, $b_ty:ty) => {{
+                let a_zero_point: Option<TensorView<$a_ty>> = inputs.get_as(2)?;
+                let b_zero_point: Option<TensorView<$b_ty>> = inputs.get_as(5)?;
+                self.run_typed(ctx, $a, a_zero_point, $b, b_zero_point)
+            }};
+        }
+
+        let result = match (a, b) {
+            (ValueView::UInt8Tensor(a), ValueView::Int8Tensor(b)) => {
+                qlinear_matmul!(a, u8, b, i8)
+            }
+            (ValueView::UInt8Tensor(a), ValueView::UInt8Tensor(b)) => {
+                qlinear_matmul!(a, u8, b, u8)
+            }
+            (ValueView::Int8Tensor(a), ValueView::Int8Tensor(b)) => {
+                qlinear_matmul!(a, i8, b, i8)
+            }
+            (ValueView::Int8Tensor(a), ValueView::UInt8Tensor(b)) => {
+                qlinear_matmul!(a, i8, b, u8)
+            }
+            _ => Err(OpError::UnsupportedType),
+        };
+        result.into_op_result()
+    }
+
+    fn prepack_inputs(&self) -> SmallVec<[usize; 1]> {
+        [3].into()
+    }
+
+    fn prepack(&self, index: usize, input: ValueView) -> Option<PrepackedInput> {
+        if index == 3 {
+            matmul_prepack_b::<u8, i8, i32>(input)
+        } else {
+            None
+        }
+    }
+
+    fn output_types(&self, _ctx: &OutputTypesContext) -> Option<OutputTypeList> {
+        Some([OutputType::CopyFromInput(7)].into())
+    }
+
+    fn as_infer_shapes(&self) -> Option<&dyn InferShapes> {
+        Some(&shape_ops::QLinearMatMul)
+    }
+}
