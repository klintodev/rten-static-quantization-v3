+/// Build a `QuantizeLinear(MatMul(DequantizeLinear(a), DequantizeLinear(b)))` expression.
+fn qdq_matmul_expr(a: Expr, b: Expr, params: &QdqParams) -> Expr {
+    let dq_a = a.apply(
+        DequantizeLinear { axis: -1 },
+        &[
+            Expr::constant(params.x_scale.clone()),
+            Expr::constant(params.x_zero.clone()),
+        ],
+        &[OutputMeta::NoMeta],
+    );
+    let dq_b = b.apply(
+        DequantizeLinear {
+            axis: params.w_dq_axis,
+        },
+        &[
+            Expr::constant(params.w_scale.clone()),
+            Expr::constant(params.w_zero.clone()),
+        ],
+        &[OutputMeta::NoMeta],
+    );
+    dq_a.apply(MatMul {}, &[dq_b], &[OutputMeta::NoMeta]).apply(
+        QuantizeLinear {
+            axis: -1,
+            output_dtype: params.q_output_dtype,
+        },
+        &[
+            Expr::constant(params.y_scale.clone()),
+            Expr::constant(params.y_zero.clone()),
+        ],
+        &[OutputMeta::NoMeta],
+    )
+}
