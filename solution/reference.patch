+        );
+
+        // Multi-element (per-row) activation zero point.
+        let a_zp = Tensor::from([0u8, 1]);
+        let mut params = ok_params.clone();
+        params[1] = Some(a_zp.view().into());
+        assert_eq!(
+            run(&params),
+            Err(OpError::unsupported_value(
+                "only per-tensor zero points are supported for this input"
+            ))
+        );
+
+        // Per-tensor weight scale with per-column zero point.
+        let b_zp = Tensor::from([0i8, 0]);
+        let mut params = ok_params.clone();
+        params[3] = Some(b_zp.view().into());
+        assert_eq!(
+            run(&params),
+            Err(OpError::invalid_value(
+                "scale and zero point must have the same granularity"
+            ))
+        );
+
+        // Per-column weight scale with per-tensor zero point.
+        let b_scale = Tensor::from([0.1f32, 0.2]);
+        let mut params = ok_params.clone();
+        params[2] = Some(b_scale.view().into());
+        assert_eq!(
+            run(&params),
+            Err(OpError::invalid_value(
+                "scale and zero point must have the same granularity"
+            ))
+        );
+
+        // Weight scale length does not match column count.
+        let b_scale = Tensor::from([0.1f32, 0.2, 0.3]);
+        let b_zp = Tensor::from([0i8, 0, 0]);
+        let mut params = ok_params.clone();
+        params[2] = Some(b_scale.view().into());
+        params[3] = Some(b_zp.view().into());
+        assert_eq!(
+            run(&params),
+            Err(OpError::incompatible_input_shapes(
+                "scale length does not match channel count"
