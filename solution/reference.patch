index 0000000000000000000000000000000000000000..4ad5bfbde323b5a747244b2c57da921d828b0483
--- /dev/null
+++ b/rten-cli/src/quantize.py
@@ -0,0 +1,767 @@
+"""ONNX graph transforms. Keep large initializer payloads on disk throughout."""
+
+import argparse
+import collections
+import hashlib
+import itertools
+import json
+import math
+import os
+from pathlib import Path
+import struct
+import subprocess
+import sys
+import tempfile
+
+EXE = sys.argv.pop(1)
+
+
+def vint(n):
+    n &= (1 << 64) - 1
+    out = bytearray()
+    while n >= 128:
+        out.append(128 | (n & 127))
+        n >>= 7
+    out.append(n)
+    return bytes(out)
+
+
+def var(b, i):
+    n = 0
+    for shift in range(0, 70, 7):
+        v = b[i]
+        i += 1
+        n |= (v & 127) << shift
+        if v < 128:
+            return n, i
+    raise ValueError("invalid protobuf varint")
+
+
+def message(buf):
+    fields = []
+    i = 0
+    while i < len(buf):
+        key, i = var(buf, i)
+        f, w = divmod(key, 8)
+        if w == 0:
+            val, i = var(buf, i)
+        else:
+            if w == 2:
+                length, i = var(buf, i)
+            else:
+                length = {1: 8, 5: 4}[w]
+            val = buf[i : i + length]
+            if len(val) != length:
+                raise ValueError("truncated protobuf")
+            i += length
+        fields.append((f, w, val))
+    return fields
+
+
+def pack(m):
+    return b"".join(
+        vint(f * 8 + w) + (vint(v) if w == 0 else (vint(len(v)) if w == 2 else b"") + v)
+        for f, w, v in m
+    )
+
+
+def fld(f, v):
+    if isinstance(v, int):
+        return (f, 0, v)
+    return (f, 2, v.encode() if isinstance(v, str) else v)
+
+
+def many(m, f):
+    return [v for k, w, v in m if k == f]
+
+
+def one(m, f, default=None):
+    return next((v for k, w, v in m if k == f), default)
+
+
+def put(m, f, values):
+    return [x for x in m if x[0] != f] + [fld(f, v) for v in values]
+
+
+def strings(m, f):
+    return [b.decode() for b in many(m, f)]
+
+
+def name(m, f):
+    return one(m, f, b"").decode()
+
+
+def child(m, f):
+    return [message(b) for b in many(m, f)]
+
+
+def ints(m, f):
+    out = []
+    for v in many(m, f):
+        if isinstance(v, int):
+            out.append(v)
+        else:
+            i = 0
+            while i < len(v):
+                x, i = var(v, i)
+                out.append(x)
+    return out
+
+
+def sign(x):
+    return x - (1 << 64) if x >= 1 << 63 else x
+
+
+def tensor(n, dt, dims, raw):
+    return [fld(8, n), fld(2, dt), *[fld(1, d) for d in dims], fld(9, raw)]
+
+
+def info(n, dt, dims):
+    shape = pack([fld(1, pack([fld(1, d)])) for d in dims])
+    return pack([fld(1, n), fld(2, pack([fld(1, pack([fld(1, dt), fld(2, shape)]))]))])
+
+
+def node(op, ins, outs, attrs=()):
+    return [
+        fld(4, op),
+        *[fld(1, x) for x in ins],
+        *[fld(2, y) for y in outs],
+        *[fld(5, a) for a in attrs],
+    ]
+
+
+def nm(n):
+    return name(n, 4)
+
+
+def subgraphs(n):
+    for a in child(n, 5):
+        if one(a, 6) is not None:
+            yield name(a, 1), message(one(a, 6))
+
+
+def nested(n, visit):
+    attrs = []
+    for a in child(n, 5):
+        if one(a, 6) is not None:
+            a = put(a, 6, [pack(visit(name(a, 1), message(one(a, 6))))])
+        attrs.append(pack(a))
+    return put(n, 5, attrs)
+
+
+def names(g, f):
+    return [name(v, 1) for v in child(g, f)]
+
+
+def external(t):
+    return {name(e, 1): name(e, 2) for e in child(t, 13)}
+
+
+def set_ext(t, location, offset, length):
+    fields = [x for x in t if x[0] not in (4, 5, 6, 7, 9, 10, 11, 13, 14)]
+    for k, v in [("location", location), ("offset", str(offset)), ("length", str(length))]:
+        fields.append(fld(13, pack([fld(1, k), fld(2, v)])))
+    return fields + [fld(14, 1)]
+
+
+DT = {
+    1: ("F32", "f"),
+    2: ("U8", "B"),
+    3: ("I8", "b"),
+    6: ("I32", "i"),
+    7: ("I64", "q"),
+    9: ("BOOL", "B"),
+    11: ("F64", "d"),
+}
+ST = {s: d for d, (s, _) in DT.items()}
+
+
+def width(dt):
+    return struct.calcsize("<" + DT[dt][1])
+
+
+def typed_raw(t):
+    raw = one(t, 9)
+    if raw is not None:
+        return raw
+    dt = one(t, 2)
+    if dt in (1, 11):
+        return b"".join(many(t, 4 if dt == 1 else 10))
+    values = ints(t, 7 if dt == 7 else 5)
+    mask = (1 << (8 * width(dt))) - 1
+    return b"".join((v & mask).to_bytes(width(dt), "little") for v in values)
+
+
+def blocks(path, offset, length):
+    with path.open("rb") as f:
+        f.seek(offset)
+        while length:
+            buf = f.read(min(length, 1 << 20))
+            if not buf:
+                raise ValueError("truncated external tensor")
+            yield buf
+            length -= len(buf)
+
+
+class Initializer:
+    def __init__(self, t, base):
+        self.t = t
+        self.dt = one(t, 2)
+        self.shape = ints(t, 1)
+        self.length = math.prod(self.shape) * width(self.dt) if self.dt in DT else 0
+        ext = external(t)
+        self.loc = None
+        if ext:
+            self.loc = (
+                (base / ext["location"]).resolve(),
+                int(ext.get("offset", 0)),
+                int(ext.get("length", self.length)),
+            )
+
+    def data(self):
+        return b"".join(blocks(*self.loc)) if self.loc else typed_raw(self.t)
+
+    def value(self):
+        return (self.dt, self.shape, self.data())
+
+    def file(self, tmp):
+        if self.loc:
+            return self.loc
+        raw = typed_raw(self.t)
+        p = tmp / ("inline-" + hashlib.sha256(raw).hexdigest())
+        if not p.exists():
+            p.write_bytes(raw)
+        return p, 0, len(raw)
+
+
+def values(v):
+    return memoryview(v[2]).cast(DT[v[0]][1])
+
+
+def scalar(dt, x):
+    return dt, [], struct.pack("<" + DT[dt][1], x)
+
+
+def read_sample(p):
+    with Path(p).open("rb") as f:
+        n = struct.unpack("<Q", f.read(8))[0]
+        header = json.loads(f.read(n))
+        base = f.tell()
+        out = {}
+        for k, h in header.items():
+            if k == "__metadata__":
+                continue
+            a, b = h["data_offsets"]
+            f.seek(base + a)
+            out[k] = ST[h["dtype"]], h["shape"], f.read(b - a)
+        return out
+
+
+def write_sample(p, data):
+    header = {}
+    off = 0
+    for k, (dt, shape, raw) in data.items():
+        header[k] = {"dtype": DT[dt][0], "shape": shape, "data_offsets": [off, off + len(raw)]}
+        off += len(raw)
+    h = json.dumps(header, separators=(",", ":")).encode()
+    h += b" " * (-len(h) % 8)
+    with p.open("wb") as f:
+        f.write(struct.pack("<Q", len(h)) + h)
+        for _, _, raw in data.values():
+            f.write(raw)
+
+
+def fingerprint(model, base):
+    h = hashlib.sha256(pack(model))
+    seen = set()
+
+    def walk(g):
+        for t in child(g, 5):
+            init = Initializer(t, base)
+            if init.loc and init.loc not in seen:
+                seen.add(init.loc)
+                for chunk in blocks(*init.loc):
+                    h.update(chunk)
+        for n in child(g, 1):
+            for _, sub in subgraphs(n):
+                walk(sub)
+
+    walk(message(one(model, 7)))
+    return h.hexdigest()
+
+
+def extent(data):
+    seq = values(data)
+    if not seq:
+        return None
+    lo, hi = min(seq), max(seq)
+    if not math.isfinite(lo) or not math.isfinite(hi):
+        raise ValueError("non-finite activation")
+    return [lo, hi]
+
+
+def update(ranges, key, span):
+    if span is None:
+        return
+    if key in ranges:
+        span = [min(ranges[key][0], span[0]), max(ranges[key][1], span[1])]
+    ranges[key] = span
+
+
+class Evaluator:
+    def __init__(self, model, base, tmp):
+        self.model = model
+        self.base = base
+        self.tmp = tmp
+
+    def primitive(self, n, env):
+        if nm(n) == "Identity":
+            v = env[strings(n, 1)[0]]
+            return [v.value() if isinstance(v, Initializer) else v]
+        initial = []
+        args = {}
+        meta = []
+        for k in dict.fromkeys(strings(n, 1)):
+            if not k:
+                continue
+            v = env[k]
+            if isinstance(v, Initializer):
+                t = v.t
+                if v.loc:
+                    path, offset, length = v.loc
+                    alias = "storage-" + hashlib.sha256(os.fsencode(path)).hexdigest() + ".data"
+                    dest = self.tmp / alias
+                    if not dest.exists():
+                        dest.symlink_to(path)
+                    t = set_ext(t, alias, offset, length)
+                initial.append(fld(5, pack(put(t, 8, [k]))))
+            else:
+                args[k] = v
+                meta.append(fld(11, info(k, v[0], v[1])))
+        outs = [k for k in strings(n, 2) if k]
+        graph = [
+            fld(2, "evaluate"),
+            fld(1, pack(n)),
+            *initial,
+            *meta,
+            *[fld(12, pack([fld(1, k)])) for k in outs],
+        ]
+        part = self.tmp / "node.onnx"
+        part.write_bytes(pack(put(self.model, 7, [pack(graph)])))
+        inp, out = self.tmp / "feed.st", self.tmp / "out.st"
+        write_sample(inp, args)
+        subprocess.run([EXE, "_quant_eval", part, inp, out], check=True)
+        result = read_sample(out)
+        return [result[k] for k in outs]
+
+    def run(self, g, feeds, scope="root", ranges=None, inherited=None):
+        env = dict(inherited or {})
+        env.update({name(t, 8): Initializer(t, self.base) for t in child(g, 5)})
+        env.update(feeds)
+
+        def val(k):
+            v = env[k]
+            return v.value() if isinstance(v, Initializer) else v
+
+        schedule = child(g, 1)
+        last_use = {}
+        for i, n in enumerate(schedule):
+            dependencies = set(strings(n, 1))
+            for _, sub in subgraphs(n):
+                dependencies.update(uses(sub))
+            for k in dependencies:
+                last_use[k] = i
+        live_out = set(names(g, 12))
+        expired = collections.defaultdict(list)
+        for k, i in last_use.items():
+            if k not in live_out:
+                expired[i].append(k)
+        for i, n in enumerate(schedule):
+            ins, outs = strings(n, 1), [k for k in strings(n, 2) if k]
+            path = f"{scope}/{i}"
+            op = nm(n)
+            if op == "If":
+                branch = "then_branch" if next(iter(values(val(ins[0])))) else "else_branch"
+                sub = dict(subgraphs(n))[branch]
+                result = self.run(sub, {}, path + "/" + branch, ranges, env)
+            elif op == "Loop":
+                sub = dict(subgraphs(n))["body"]
+                si = names(sub, 11)
+                steps = next(iter(values(val(ins[0])))) if ins[0] else sys.maxsize
+                cond = next(iter(values(val(ins[1])))) if ins[1] else True
+                carries = [val(k) for k in ins[2:]]
+                scans = [[] for _ in outs[len(carries) :]]
+                step = 0
+                while step < steps and cond:
+                    feed = dict(zip(si, [scalar(6, step), scalar(6, cond), *carries]))
+                    row = self.run(sub, feed, path + "/body", ranges, env)
+                    cond = next(iter(values(row[0])))
+                    carries = row[1 : 1 + len(carries)]
+                    for scan, v in zip(scans, row[1 + len(carries) :]):
+                        scan.append(v)
+                    step += 1
+
+                def stack(scan):
+                    if not scan:
+                        raise ValueError("cannot infer empty scan shape")
+                    return scan[0][0], [len(scan), *scan[0][1]], b"".join(v[2] for v in scan)
+
+                result = [*carries, *map(stack, scans)]
+            else:
+                result = self.primitive(n, env)
+            env.update(zip(outs, result))
+            if ranges is not None and op in ("Conv", "MatMul") and result[0][0] == 1:
+                for j, k in enumerate([*ins[:2], outs[0]]):
+                    if j == 1 and isinstance(env[k], Initializer):
+                        continue
+                    update(ranges, path + "/" + str(j), extent(val(k)))
+            for k in expired[i]:
+                env.pop(k, None)
+        return [val(k) for k in names(g, 12)]
+
+
+def uses(g):
+    """Names consumed by this graph, including lexical captures."""
+    needed = set(names(g, 12))
+    for n in child(g, 1):
+        needed.update(strings(n, 1))
+        for _, sub in subgraphs(n):
+            needed.update(
+                uses(sub)
+                - set(names(sub, 11))
+                - {name(t, 8) for t in child(sub, 5)}
+                - {k for sn in child(sub, 1) for k in strings(sn, 2)}
+            )
+    return needed
+
+
+def f32(x):
+    return struct.unpack("<f", struct.pack("<f", x))[0]
+
+
+def scale(span):
+    return f32(max(abs(x) for x in span) / 127) or 1.0
+
+
+def attr(n, k, default):
+    for a in child(n, 5):
+        if name(a, 1) == k:
+            return sign(one(a, 3, default))
+    return default
+
+
+def optimize_graph(g, base, fresh, outer=None, types=None):
+    const = dict(outer or {})
+    const.update({name(t, 8): Initializer(t, base) for t in child(g, 5)})
+    desc = dict(types or {})
+    for v in child(g, 11) + child(g, 12) + child(g, 13):
+        tp = one(message(one(v, 2, b"")), 1)
+        if tp:
+            typ = message(tp)
+            shape = one(typ, 2)
+            desc[name(v, 1)] = (
+                one(typ, 1),
+                [one(d, 1) for d in child(message(shape), 1)] if shape is not None else None,
+            )
+    desc.update({k: (v.dt, v.shape) for k, v in const.items()})
+    nodes = [
+        nested(n, lambda _, s: optimize_graph(s, base, fresh, const, desc)) for n in child(g, 1)
+    ]
+    counts = collections.Counter(k for n in nodes for k in strings(n, 1))
+    counts.update(names(g, 12))
+    for n in nodes:
+        for _, s in subgraphs(n):
+            counts.update(uses(s))
+    producers = {k: i for i, n in enumerate(nodes) for k in strings(n, 2)}
+    drop = set()
+    added = []
+
+    def fail_unless(b):
+        if not b:
+            raise ValueError("ineligible")
+
+    def params(s, z):
+        a, b = const[s], const[z]
+        fail_unless(a.dt == 1 and b.dt in (2, 3) and len(a.shape) <= 1 and len(b.shape) <= 1)
+        vals = list(values(a.value()))
+        fail_unless(
+            vals
+            and all(x > 0 and math.isfinite(x) for x in vals)
+            and len(vals) == math.prod(b.shape)
+        )
+        return vals, b.dt
+
+    for i, q in enumerate(nodes):
+        if nm(q) != "QuantizeLinear" or name(q, 7) or len(strings(q, 1)) != 3:
+            continue
+        try:
+            y, ys, yz = strings(q, 1)
+            cidx = producers[y]
+            c = nodes[cidx]
+            ci = strings(c, 1)
+            op = nm(c)
+            fail_unless(op in ("Conv", "MatMul") and not name(c, 7) and counts[y] == 1)
+            a, b = ci[:2]
+            ai, bi = producers[a], producers[b]
+            dx, dw = nodes[ai], nodes[bi]
+            fail_unless(
+                all(nm(n) == "DequantizeLinear" and not name(n, 7) for n in (dx, dw))
+                and counts[a] == counts[b] == 1
+            )
+            x, xs, xz = strings(dx, 1)
+            w, ws, wz = strings(dw, 1)
+            xv, xd = params(xs, xz)
+            wv, wd = params(ws, wz)
+            yv, yd = params(ys, yz)
+            fail_unless(len(xv) == len(yv) == 1 and attr(q, "output_dtype", yd) in (0, yd))
+            fail_unless(desc.get(x, (xd, None))[0] == xd and desc.get(w, (wd, None))[0] == wd)
+            dims = desc.get(w, (wd, None))[1]
+            if len(wv) > 1:
+                fail_unless(dims and (op == "Conv" or len(dims) >= 2))
+                axis = attr(dw, "axis", 1)
+                axis = axis + len(dims) if axis < 0 else axis
+                target = 0 if op == "Conv" else len(dims) - 1
+                fail_unless(axis == target and dims[target] in (len(wv), None))
+            args = [x, xs, xz, w, ws, wz, ys, yz]
+            if len(ci) > 2 and ci[2]:
+                bias = const[ci[2]]
+                fail_unless(op == "Conv" and bias.dt == 1 and len(bias.shape) == 1)
+                nums = list(values(bias.value()))
+                fail_unless(
+                    (not dims or dims[0] in (None, len(nums))) and len(wv) in (1, len(nums))
+                )
+                codes = [v / (xv[0] * wv[j % len(wv)]) for j, v in enumerate(nums)]
+                fail_unless(all(v.is_integer() and -(2**31) <= v < 2**31 for v in codes))
+                bn = fresh()
+                added.append(
+                    tensor(bn, 6, [len(nums)], struct.pack("<" + "i" * len(nums), *map(int, codes)))
+                )
+                args.append(bn)
+            nodes[i] = node("QLinear" + op, args, strings(q, 2), many(c, 5))
+            drop.update([ai, bi, cidx])
+        except (KeyError, ValueError, IndexError):
+            continue
+    return put(
+        put(g, 1, [pack(n) for i, n in enumerate(nodes) if i not in drop]),
+        5,
+        many(g, 5) + list(map(pack, added)),
+    )
+
+
+class Export:
+    def __init__(self, base, tmp, ranges, fmt, mask, model):
+        self.base, self.tmp, self.ranges, self.fmt, self.mask = base, tmp, ranges, fmt, mask
+        self.sequence = 0
+        self.existing = set()
+
+        def reserve(g):
+            self.existing.update(uses(g) | set(names(g, 11)) | {name(t, 8) for t in child(g, 5)})
+            for n in child(g, 1):
+                self.existing.update(strings(n, 2))
+                for _, s in subgraphs(n):
+                    reserve(s)
+
+        reserve(message(one(model, 7)))
+        self.cache = {}
+        self.references = {}
+
+    def fresh(self):
+        while True:
+            self.sequence += 1
+            k = "__quant_" + str(self.sequence)
+            if k not in self.existing:
+                return k
+
+    def graph(self, g, scope="root", outer=None):
+        const = dict(outer or {})
+        const.update({name(t, 8): Initializer(t, self.base) for t in child(g, 5)})
+        initial = child(g, 5)
+        nodes = []
+
+        def add(dt, shape, raw):
+            k = self.fresh()
+            initial.append(tensor(k, dt, shape, raw))
+            return k
+
+        def par(s, dt, z):
+            return [add(1, [], struct.pack("<f", s)), add(dt, [], struct.pack("<" + DT[dt][1], z))]
+
+        def emit(op, inputs, output=None):
+            k = output or self.fresh()
+            nodes.append(node(op, inputs, [k]))
+            return k
+
+        for i, n in enumerate(child(g, 1)):
+            path = f"{scope}/{i}"
+            n = nested(n, lambda k, sub: self.graph(sub, path + "/" + k, const))
+            if path not in self.mask:
+                nodes.append(n)
+                continue
+            ins = strings(n, 1)
+            x, w = ins[:2]
+            y = strings(n, 2)[0]
+            op = nm(n)
+            sx = scale(self.ranges[path + "/0"])
+            sy = scale(self.ranges[path + "/2"])
+            px, py = par(sx, 2, 128), par(sy, 2, 128)
+            qx = emit("QuantizeLinear", [x, *px])
+            if w in const:
+                weight = const[w]
+                loc = weight.file(self.tmp)
+                if loc not in self.cache:
+                    args = [EXE, "_quant_weight", loc[0], str(loc[1]), str(loc[2])]
+                    sw = scale([float(subprocess.check_output(args))])
+                    blob = self.tmp / ("encoded-" + str(len(self.cache)))
+                    subprocess.run([*args, blob, str(sw)], stdout=subprocess.DEVNULL, check=True)
+                    self.cache[loc] = (sw, blob)
+                sw, blob = self.cache[loc]
+                qw = self.fresh()
+                self.references[qw] = (blob, 0, blob.stat().st_size)
+                initial.append(
+                    set_ext(tensor(qw, 3, weight.shape, b""), "placeholder", 0, blob.stat().st_size)
+                )
+                pw = par(sw, 3, 0)
+            else:
+                sw = scale(self.ranges[path + "/1"])
+                pw = par(sw, 3, 0)
+                qw = emit("QuantizeLinear", [w, *pw])
+            if self.fmt == "qdq":
+                dx = emit("DequantizeLinear", [qx, *px])
+                dw = emit("DequantizeLinear", [qw, *pw])
+                fy = self.fresh()
+                nodes.append(node(op, [dx, dw, *ins[2:]], [fy], many(n, 5)))
+                qy = emit("QuantizeLinear", [fy, *py])
+            else:
+                args = [qx, *px, qw, *pw, *py]
+                if len(ins) > 2 and ins[2]:
+                    if ins[2] not in const:
+                        raise ValueError("dynamic Conv bias is unsupported for integer export")
+                    biases = [
+                        max(-(2**31), min(2**31 - 1, round(v / (sx * sw))))
+                        for v in values(const[ins[2]].value())
+                    ]
+                    args.append(
+                        add(6, [len(biases)], struct.pack("<" + "i" * len(biases), *biases))
+                    )
+                qy = self.fresh()
+                nodes.append(node("QLinear" + op, args, [qy], many(n, 5)))
+            emit("DequantizeLinear", [qy, *py], y)
+        out = put(g, 1, list(map(pack, nodes)))
+        wanted = uses(out) | set(names(out, 11))
+        return put(out, 5, [pack(t) for t in initial if name(t, 8) in wanted])
+
+    def bundle(self, model, g, out):
+        offsets = {}
+        side = out.with_name(out.name + ".data")
+        with side.open("wb") as f:
+
+            def relocate(g):
+                tensors = []
+                for t in child(g, 5):
+                    if external(t):
+                        loc = self.references.get(name(t, 8)) or Initializer(t, self.base).loc
