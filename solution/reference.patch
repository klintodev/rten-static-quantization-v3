+        );
+
+        // Zero output scale.
+        let y_scale = Tensor::from(0f32);
+        let mut params = ok_params.clone();
+        params[4] = Some(y_scale.view().into());
+        assert_eq!(
+            run(&params),
+            Err(OpError::invalid_value("scale must be positive and finite"))
+        );
+
+        // Output zero point with unsupported type.
+        let y_zp = Tensor::from(0f32);
+        let mut params = ok_params.clone();
+        params[5] = Some(y_zp.view().into());
+        assert_eq!(run(&params), Err(OpError::UnsupportedType));
+    }
